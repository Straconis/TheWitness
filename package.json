{
  "name": "the-witness",
  "version": "0.1.5",
  "description": "Private hosted multitrack Discord recording package based on Craig.",
  "main": "dist/index.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "npm run build && npm run build:cook && node --test tests/*.test.cjs",
    "build:cook": "node scripts/build-cook.cjs",
    "export": "node dist/exports/cli.js",
    "check:host": "node scripts/check-host.cjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@discordjs/opus": "^0.10.0",
    "@snazzah/davey": "^0.1.12",
    "dotenv": "^17.4.2",
    "eris": "github:CraigChat/dysnomia#cd792c8ee75970bb44d33baafb6c6ff7123e86f9",
    "nanoid": "^6.0.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "@discordjs/opus@0.10.0": true,
    "esbuild@0.28.2": true
  },
  "private": true,
  "overrides": {
    "tar": "7.5.22",
    "brace-expansion": "1.1.21"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
