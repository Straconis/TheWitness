#!/bin/bash
# Installed as root-owned /usr/local/sbin/witness-admin. Deployments never update it.
set -euo pipefail
[[ $EUID == 0 ]] || { echo 'Run with sudo.' >&2; exit 1; }
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
unset PYTHONPATH PYTHONHOME BASH_ENV ENV CDPATH
cd /
base=/usr/local/libexec/the-witness-admin
[[ ( $# == 1 && $1 != portal-username ) || ( $# == 2 && $1 == portal-username ) ]] || { echo 'Choose one admin action; see operator documentation.' >&2; exit 2; }
case "$1" in
 portal-username) exec /usr/bin/python3 -I "$base/set-portal-username.py" "$2" ;;
 log-setup) exec /bin/bash --noprofile --norc "$base/enable-log-portal.sh" setup ;;
 refresh-redactions) exec /bin/bash --noprofile --norc "$base/enable-log-portal.sh" --refresh-redactions ;;
 cloudflare-ips) exec /usr/bin/python3 -I "$base/configure-witness-log-real-ip.py" ;;
 cloudflare-check) exec /usr/bin/python3 -I "$base/configure-witness-log-real-ip.py" --check ;;
 downloads-domain|downloads-ip) exec /usr/bin/python3 -I "$base/run-admin-downloads.py" "$1" ;;
 deployment-status) exec /usr/sbin/runuser -u witness-deploy -- /bin/bash -c 'cd /opt/the-witness && /usr/local/bin/node scripts/deploy-idle.cjs' ;;
 deploy-permissions) exec /bin/bash --noprofile --norc "$base/enable-github-deploy.sh" ;;
 *) echo 'Unknown admin action.' >&2; exit 2 ;;
esac
