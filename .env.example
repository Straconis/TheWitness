DISCORD_TOKEN=
RECORDING_PATH=recordings

# Optional executable path for audio exports; bundled FFmpeg is the default
FFMPEG_PATH=

# Optional private download service. Set both to enable.
# Use the port allocated by your host and your public HTTPS origin.
DOWNLOAD_PORT=
DOWNLOAD_PUBLIC_URL=
# Address the download listener binds to. Use 127.0.0.1 when nginx proxies to it.
DOWNLOAD_BIND_HOST=0.0.0.0

# Optional overrides; bundled whisper.cpp uses small.en when installed, otherwise base.en.
# Execution is opt-in per export. English model; use a multilingual model for other languages.
TRANSCRIPTION_EXECUTABLE=
TRANSCRIPTION_MODEL=
# Optional speech detector, off unless set: a model path, or auto for bin/models/ggml-silero-v6.2.0.bin.
# Off by default because whisper.cpp 1.8.7 VAD was very slow on a 2-core VPS (81.5 s of an 86 s run); time it before enabling.
# Needs a whisper-cli that supports --vad; otherwise transcription reports not ready.
TRANSCRIPTION_VAD_MODEL=
TRANSCRIPTION_THREADS=2
TRANSCRIPTION_TIMEOUT_MINUTES=30
TRANSCRIPTION_LANGUAGE=en
# Optional spelling hints for names/places; maximum 2000 characters.
TRANSCRIPTION_PROMPT=

# Optional cloud uploads. Each Discord server connects its own account with /cloud;
# these are only this bot's app registrations, and no server's files go to the owner.
# Register https://YOUR-PUBLIC-WITNESS-ADDRESS/oauth/callback with each provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
# Encrypts each server's saved sign-in tokens. Required before any server can connect.
# Create one with: openssl rand -hex 32. Back it up; losing it means every server reconnects.
CLOUD_TOKEN_KEY=
# Optional comma-separated Discord server IDs allowed to use cloud uploads. Empty allows every server.
CLOUD_UPLOAD_GUILD_IDS=

# Exports that may run at once across every server (1-16, default 1), like Craig's QUEUE_SIZE.
# Later exports wait in order and see their queue position in Discord and on the job page.
EXPORT_CONCURRENCY=1

# Warn below this many GiB of available disk space; never deletes recordings.
LOW_DISK_WARNING_GIB=1
# Below this many MiB free, active recordings are stopped cleanly and new exports are paused.
# 0 turns the emergency stop off. Capped at half of LOW_DISK_WARNING_GIB.
CRITICAL_DISK_MIB=256

# Audible notice once a new recording starts (on/off, default on).
# Per-server settings can choose the bundled recording notice, an uploaded sound, or off.
START_SOUND=on
# Optional regular stereo Ogg Opus file: 20 ms frames, 0.2–10 seconds, <=1 MiB.
# An invalid override warns and falls back to assets/audio/witness-start.ogg.
START_SOUND_DEFAULT_PATH=

# Independent speaker cleanup: auto uses up to 3 workers with CPU/RAM/disk admission; off forces serial.
EXPORT_PARALLEL_TRACKS=auto
