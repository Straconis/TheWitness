DISCORD_TOKEN=
RECORDING_PATH=recordings

# Optional executable path for audio exports; bundled FFmpeg is the default
FFMPEG_PATH=

# Optional private download service. Set both to enable.
# Use the port allocated by your host and your public HTTPS origin.
DOWNLOAD_PORT=
DOWNLOAD_PUBLIC_URL=

# Optional overrides; bundled whisper.cpp and base.en are used by default.
# Execution is opt-in per export. English model; use a multilingual model for other languages.
TRANSCRIPTION_EXECUTABLE=
TRANSCRIPTION_MODEL=
TRANSCRIPTION_THREADS=2
TRANSCRIPTION_TIMEOUT_MINUTES=30
TRANSCRIPTION_LANGUAGE=en
# Optional spelling hints for names/places; maximum 2000 characters.
TRANSCRIPTION_PROMPT=

# Optional cloud upload credentials, supplied by the owner.
# Prefer browser OAuth connections; saved credentials refresh automatically.
# Access/refresh tokens are optional alternatives for advanced owner setup.
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
DROPBOX_REFRESH_TOKEN=
DROPBOX_CLIENT_ID=
BOX_CLIENT_SECRET=
BOX_REFRESH_TOKEN=
BOX_ACCESS_TOKEN=
DROPBOX_FOLDER=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_ACCESS_TOKEN=
GOOGLE_FOLDER=
ONEDRIVE_CLIENT_ID=
ONEDRIVE_CLIENT_SECRET=
ONEDRIVE_REFRESH_TOKEN=
ONEDRIVE_ACCESS_TOKEN=
ONEDRIVE_FOLDER=
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=
BOX_REFRESH_TOKEN=
BOX_ACCESS_TOKEN=
BOX_FOLDER=

# Warn below this many GiB of available disk space; never deletes recordings.
LOW_DISK_WARNING_GIB=1
