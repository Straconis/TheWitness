DISCORD_TOKEN=
RECORDING_PATH=recordings

# Optional executable path for WAV, FLAC and MP3 exports
FFMPEG_PATH=

# Optional private download service. Set both to enable.
# Use the port allocated by your host and your public HTTPS origin.
DOWNLOAD_PORT=
DOWNLOAD_PUBLIC_URL=

# Optional local whisper.cpp transcription; both are required.
TRANSCRIPTION_EXECUTABLE=
TRANSCRIPTION_MODEL=

# Optional cloud upload credentials, supplied by the owner.
# Tokens expire; automatic OAuth refresh is not implemented yet.
DROPBOX_ACCESS_TOKEN=
DROPBOX_FOLDER=
GOOGLE_ACCESS_TOKEN=
GOOGLE_FOLDER=
ONEDRIVE_ACCESS_TOKEN=
ONEDRIVE_FOLDER=
BOX_ACCESS_TOKEN=
BOX_FOLDER=
